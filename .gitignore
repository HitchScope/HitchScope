# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Xcode
*.xcodeproj
*.xcworkspace
xcuserdata/
DerivedData/
.DS_Store

# Example app's .xcodeproj is otherwise regenerated by xcodegen and not
# committed - but Xcode Cloud needs a real project + shared scheme
# committed to detect anything at all (ci_scripts/ci_post_clone.sh
# regenerates the real one fresh on every CI build regardless, so this
# committed copy only needs to exist, not stay in sync). Minimal set only:
# project.pbxproj + the shared scheme - no xcuserdata (per-user cruft,
# stays ignored even here).
!Example/HitchScopeExample.xcodeproj/
!Example/HitchScopeExample.xcodeproj/project.pbxproj
!Example/HitchScopeExample.xcodeproj/project.xcworkspace/
!Example/HitchScopeExample.xcodeproj/project.xcworkspace/contents.xcworkspacedata
!Example/HitchScopeExample.xcodeproj/xcshareddata/
!Example/HitchScopeExample.xcodeproj/xcshareddata/xcschemes/
!Example/HitchScopeExample.xcodeproj/xcshareddata/xcschemes/HitchScopeExample.xcscheme
# Local per-instance Xcode Cloud bookkeeping - Xcode recreates this on its
# own, and it's tied to this specific generated copy's UUIDs, not something
# that should be committed.
Example/HitchScopeExample.xcodeproj/xcshareddata/xcodecloud/
